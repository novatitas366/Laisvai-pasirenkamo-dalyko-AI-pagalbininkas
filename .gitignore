# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables (Never commit these!)
.env
server/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
client/dist/
build/
.vite/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
server/logs/

# Uploads and temporary files
server/uploads/*
!server/uploads/.gitkeep
server/uploads/tmp/*
!server/uploads/tmp/.gitkeep

# Test coverage
coverage/
client/coverage/
server/coverage/

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# Project specific
# We generally keep package-lock.json unless the project explicitly wants to ignore it. 
# In this case, since it was in the ignore list of the incoming branch, I'll keep it as requested by that branch's logic.
package-lock.json
client/package-lock.json
server/package-lock.json
