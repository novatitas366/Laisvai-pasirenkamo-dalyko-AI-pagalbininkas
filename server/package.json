{
  "name": "elective-assistant-server",
  "version": "1.0.0",
  "description": "AI elective course assistant - backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit --coverage",
    "test:auth-integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit --no-coverage --testPathPatterns auth.integration",
    "test:chat-integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit --no-coverage --testPathPatterns=chat.integration",
    "test:integration:hobbies": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.cjs --runInBand --forceExit --no-coverage integration/hobbies",
    "test:integration:profile": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit --testPathPatterns profile.integration --no-coverage",
    "test:integration:document-extract": "node --experimental-vm-modules node_modules/.bin/jest --config jest.integration.config.cjs --runInBand --forceExit integration/document-extract",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit --no-coverage --testPathPatterns='integration'",
    "test:all": "node --experimental-vm-modules node_modules/.bin/jest --config jest.config.cjs --runInBand --forceExit",
    "setup-db": "node src/scripts/setupDatabase.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "^1.12.0",
    "multer": "^2.1.1",
    "mysql2": "^3.12.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@jest/globals": "^30.3.0",
    "babel-jest": "^30.3.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "jest": "^30.3.0",
    "ms": "^2.1.3",
    "supertest": "^7.2.2"
  }
}
